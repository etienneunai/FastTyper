[Unit]
Description=FastTyper Grammar Daemon (Llama Server Vulkan)
After=network.target

[Service]
Type=simple
Environment="PORT=8808"
Environment="HOST=127.0.0.1"
Environment="VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json"
Environment="AMD_VULKAN_ASYNC_COMPUTE=1"
EnvironmentFile=-%h/.config/fasttyper/config
EnvironmentFile=-/etc/fasttyper/config
# -ngl 99: Offload all layers
# -cb: Continuous batching
# --split-mode none: Optimal for UMA iGPUs
# -c 2048: Cap context (model default is 32k, wasteful on shared-memory iGPU)
# --reasoning off: Force-disable Qwen3 thinking mode (equivalent to template
#   enable_thinking=false, which emits an empty <think></think> marker). Qwen3
#   thinks by default and decides per prompt — the "proofreader"/"cleaner"
#   presets burn the whole max_tokens budget on reasoning_content and return
#   empty output (see llm-log.txt). This makes the model answer directly.
ExecStart=/usr/local/bin/llama-server \
  -m %h/.local/share/models/dyslexic-writer-qwen3-4b-q4_k_m.gguf \
  --port $PORT \
  --host $HOST \
  -ngl 99 \
  -cb \
  --split-mode none \
  -c 2048 \
  --reasoning off \
  --threads 4
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
