[Unit]
Description=FastTyper Grammar Daemon (Llama Server)
After=network.target

[Service]
Type=simple
Environment="PORT=8808"
Environment="HOST=127.0.0.1"
Environment="MODEL=%h/.local/share/models/dyslexic-writer-qwen3-4b-q4_k_m.gguf"
Environment="N_GPU_LAYERS=99"
Environment="CTX_SIZE=2048"
Environment="THREADS=4"
Environment="EXTRA_ARGS=-cb --reasoning off"
Environment="LLAMA_SERVER_BIN=%h/.local/bin/llama-server"
EnvironmentFile=-%h/.config/fasttyper/config
EnvironmentFile=-/etc/fasttyper/config

# If LLAMA_SERVER_BIN is not at specified path, fallback search ~/.local/bin, /usr/local/bin, and PATH
ExecStart=/bin/sh -c 'BIN="$LLAMA_SERVER_BIN"; if [ ! -x "$BIN" ]; then if [ -x "%h/.local/bin/llama-server" ]; then BIN="%h/.local/bin/llama-server"; elif [ -x "/usr/local/bin/llama-server" ]; then BIN="/usr/local/bin/llama-server"; else BIN="$(command -v llama-server || echo "$LLAMA_SERVER_BIN")"; fi; fi; exec "$BIN" -m "$MODEL" --port "$PORT" --host "$HOST" -ngl "$N_GPU_LAYERS" -c "$CTX_SIZE" --threads "$THREADS" $EXTRA_ARGS'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
