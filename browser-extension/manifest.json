{
  "manifest_version": 3,
  "name": "FastTyper",
  "version": "0.2.0",
  "description": "Real-time grammar correction in web text fields, powered by a local llama.cpp daemon.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8808/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FastTyper"
  },
  "commands": {
    "toggle-corrections": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Pause/resume FastTyper corrections"
    }
  }
}
